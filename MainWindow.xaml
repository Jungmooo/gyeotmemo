<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="곁메모" Width="380" Height="650" MinWidth="330" MinHeight="490"
        WindowStyle="None" ResizeMode="CanResize" Background="#FAF9F6"
        FontFamily="Malgun Gothic" FontSize="13" Foreground="#272B28"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#272B28"/>
    <SolidColorBrush x:Key="Muted" Color="#858B85"/>
    <SolidColorBrush x:Key="Green" Color="#38634F"/>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#727B73"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E7EBE5"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#D6E1D6"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#38634F"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#272B28"/>
      <Setter Property="SelectionBrush" Value="#B8D4BE"/>
      <Setter Property="CaretBrush" Value="#38634F"/>
      <Setter Property="Padding" Value="0,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,5,12,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="21" Height="21" Background="Transparent">
              <Border x:Name="Box" Width="19" Height="19" CornerRadius="6" BorderThickness="1.3" BorderBrush="#C4CCC1" Background="#FFFEFB"/>
              <Path x:Name="Tick" Data="M 5.5,10.5 L 9,14 L 15.5,6.5" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#38634F"/><Setter TargetName="Box" Property="BorderBrush" Value="#38634F"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#38634F"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#38634F"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="Transparent" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0F1EA"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#DCE4D8"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#BED0BA"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#DFE2D9" BorderThickness="1">
    <Grid x:Name="LayoutGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="32"/>
      </Grid.RowDefinitions>
      <Border x:Name="TitleBar" Background="#F0F1E9" BorderBrush="#E5E7DE" BorderThickness="0,0,0,1" Padding="15,0,9,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border Width="22" Height="25" Background="#38634F" CornerRadius="5" Margin="0,0,9,0">
              <Path Data="M 5.5,12 L 9,15.5 L 16.5,7.5" Stroke="#FFFFFF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
            <TextBlock Text="곁메모" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <Button x:Name="PinButton" Grid.Column="1" ToolTip="항상 위 고정 켜기 / 끄기 (Ctrl+Shift+P)" AutomationProperties.Name="항상 위 고정" Margin="0,0,6,0" VerticalAlignment="Center" Padding="9,5">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE718;" FontSize="11" Margin="0,1,5,0"/><TextBlock x:Name="PinLabel" Text="고정" FontSize="11"/></StackPanel>
          </Button>
          <Button x:Name="MinimizeButton" Grid.Column="2" Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="최소화" AutomationProperties.Name="최소화"/>
          <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource WindowButton}" Content="&#xE8BB;" ToolTip="저장하고 닫기" AutomationProperties.Name="닫기"/>
        </Grid>
      </Border>
      <Grid x:Name="ContentGrid" Grid.Row="1" Margin="20,21,20,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="89"/>
          <RowDefinition Height="10"/>
          <RowDefinition x:Name="NoteRow" Height="136" MinHeight="82"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="DateLabel" Foreground="#7C8579" FontSize="11"/>
          <Grid Margin="0,7,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="오늘의 할 일" FontSize="23" FontWeight="Bold"/>
            <Border Grid.Column="1" Background="#EAF0E5" CornerRadius="10" Padding="8,4" VerticalAlignment="Center"><TextBlock x:Name="CountLabel" Text="0 / 0" Foreground="#38634F" FontSize="11" FontWeight="Bold"/></Border>
          </Grid>
        </StackPanel>
        <ProgressBar x:Name="Progress" Grid.Row="1" Height="3" Minimum="0" Maximum="1" Value="0" BorderThickness="0" Background="#E4E8DE" Foreground="#7F9D74" Margin="0,0,0,18"/>
        <Border Grid.Row="2" BorderBrush="#D6DECE" BorderThickness="1" CornerRadius="10" Background="#FFFEFB" Padding="12,7,6,7" Margin="0,0,0,13">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="InputPlaceholder" Text="할 일을 적고 Enter" Foreground="#9AA092" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="TaskInput" AutomationProperties.Name="새 할 일" MaxLength="4000" VerticalAlignment="Center"/>
            <Button x:Name="AddButton" Grid.Column="1" Content="＋" FontSize="22" Padding="0" Height="30" Foreground="#38634F" ToolTip="할 일 추가 (Enter)" AutomationProperties.Name="할 일 추가"/>
          </Grid>
        </Border>
        <Grid Grid.Row="3">
          <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="64"/><RowDefinition Height="25"/></Grid.RowDefinitions>
          <ListBox x:Name="TaskList" FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" AllowDrop="True" AutomationProperties.Name="할 일 목록">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="1,9,3,9">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="33"/><ColumnDefinition/><ColumnDefinition Width="25"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions>
                  <TextBlock Tag="DragHandle" Text="⠿" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#C1C8BB" Cursor="SizeAll" VerticalAlignment="Top" Margin="0,5,0,0" ToolTip="드래그로 순서 변경 (Alt+↑ / ↓)"/>
                  <CheckBox Grid.Column="1" IsChecked="{Binding Completed, Mode=TwoWay}" AutomationProperties.Name="완료 표시"/>
                  <TextBlock Grid.Column="2" Tag="TaskTitle" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,5,4,3" VerticalAlignment="Top" ToolTip="두 번 클릭하여 수정 (F2)">
                    <TextBlock.Style><Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#363E34"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Completed}" Value="True"><Setter Property="Foreground" Value="#949D8E"/><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger>
                        <DataTrigger Binding="{Binding Editing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                      </Style.Triggers>
                    </Style></TextBlock.Style>
                  </TextBlock>
                  <TextBox Grid.Column="2" x:Name="TaskEditor" Tag="TaskEditor" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Editing, Converter={StaticResource BoolVisibility}}" MaxLength="4000" TextWrapping="Wrap" Background="#FFFEFB" BorderBrush="#BED0BA" BorderThickness="0,0,0,1" Padding="2,4" AutomationProperties.Name="할 일 수정"/>
                  <Button Grid.Column="3" Tag="EditTask" FontFamily="Segoe MDL2 Assets" Content="&#xE70F;" FontSize="10" Padding="0" Height="28" VerticalAlignment="Top" Foreground="#929B8B" ToolTip="수정" AutomationProperties.Name="할 일 수정하기"/>
                  <Button Grid.Column="4" Tag="DeleteTask" FontFamily="Segoe MDL2 Assets" Content="&#xE711;" FontSize="10" Padding="0" Height="28" VerticalAlignment="Top" Foreground="#929B8B" ToolTip="삭제 (아래 되돌리기로 복원)" AutomationProperties.Name="할 일 삭제"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,8,0,12">
            <Border Width="44" Height="48" Background="#EEF1E7" CornerRadius="10" HorizontalAlignment="Center" Margin="0,0,0,12"><Path Data="M 12,24 L 19,31 L 33,16" Stroke="#A5B79A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
            <TextBlock Text="가볍게 하나부터 시작해요" Foreground="#858F7D" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="오늘 기억할 일을 위에 적어 주세요." Foreground="#A3AA9C" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="RemainingLabel" FontSize="10" Foreground="#949C8D" VerticalAlignment="Center"/>
          <Button x:Name="ClearCompletedButton" Grid.Column="1" Content="완료 정리" FontSize="10" Padding="5,3" ToolTip="완료한 항목을 정리합니다. 되돌리기로 복원할 수 있습니다."/>
        </Grid>
        </Grid>
        <GridSplitter x:Name="NoteSplitter" Grid.Row="4" Height="8" VerticalAlignment="Center" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" ToolTip="드래그하여 메모 영역 크기 조절">
          <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="Transparent"><Border Height="1" Background="#E3E7DC" VerticalAlignment="Center"/><Border Width="28" Height="3" CornerRadius="2" Background="#CED6C5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ControlTemplate></GridSplitter.Template>
        </GridSplitter>
        <Grid Grid.Row="5" Margin="0,8,0,7">
          <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal"><TextBlock Text="메모" FontSize="11" FontWeight="Bold" Foreground="#6F7B65"/><TextBlock Text="생각을 잠깐 놓아두는 곳" FontSize="10" Foreground="#A4AC9C" Margin="8,1,0,0"/></StackPanel>
          <Grid Grid.Row="1">
            <TextBlock x:Name="NotePlaceholder" Text="자유롭게 적어 두세요…" Foreground="#ABB2A3" FontSize="12" IsHitTestVisible="False" Margin="0,4,0,0"/>
            <TextBox x:Name="NoteInput" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="200000" AutomationProperties.Name="자유 메모"/>
          </Grid>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="#F1F3EB" BorderBrush="#E7EADF" BorderThickness="0,1,0,0" Padding="20,0,17,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="SaveLabel" Text="자동 저장" FontSize="10" Foreground="#8D9881" VerticalAlignment="Center"/>
          <Button x:Name="UndoButton" Grid.Column="1" Content="삭제 되돌리기" FontSize="10" Padding="5,2" Visibility="Collapsed" ToolTip="마지막 삭제 되돌리기 (목록에서 Ctrl+Z)"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
